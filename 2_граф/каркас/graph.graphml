<node id="OOO.physics.oge.el.1.18">
  <data key="d0">exam_element</data>
  <data key="d1">1.18 Кинетическая и потенциальная энергия. Формула для вычисления кинетической энергии: 2 m E = . k 2 Теорема о кинетической</data>
