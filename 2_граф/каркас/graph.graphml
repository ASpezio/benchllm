  <data key="d0">section</data>
  <data key="d1">11 Культурное пространство советского общества в 1920–1930-е гг.</data>
  <data key="d2">history</data>
  <data key="d3">SOO</data>
  <data key="d4">10</data>
  <data key="d6">11</data>
  <data key="d7">Культурное пространство советского общества в 1920–1930-е гг.</data>
  <data key="d8">1096</data>
