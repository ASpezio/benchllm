  <data key="d3">SOO</data>
  <data key="d6">4.1.3</data>
  <data key="d7">Фотоэффект. Опыты А.Г. Столетова. Законы фотоэффекта</data>
  <data key="d8">1036</data>
  <data key="d9">приказ</data>
</node>
<node id="SOO.physics.ege.el.4.1.4">
  <data key="d0">exam_element</data>
  <data key="d1">4.1.4 Уравнение Эйнштейна для фотоэффекта: E = A + E , ф о т о н а в ы х о д а к и н m a x h с h с где , , E = h  = A = h  =</data>
  <data key="d2">physics</data>
  <data key="d3">SOO</data>
  <data key="d6">4.1.4</data>
  <data key="d7">Уравнение Эйнштейна для фотоэффекта: E = A + E , ф о т о н а в ы х о д а к и н m a x h с h с где , , E = h  = A = h  = ф о т о н а  в ы х о д а к р  к р m 2m  E = a x = e U к и н m a x 2 з а п</data>
  <data key="d8">1036</data>
  <data key="d9">приказ</data>
  <data key="d18">Уравнение Эйнштейна для фотоэффекта: $E_{\text{фотона}} = A_{\text{выхода}} + E_{\text{кин max}}$, где $E_{\text{фотона}} = h\nu = \frac{hc}{\lambda}$, $A_{\text{выхода}} = h\nu_{\text{кр}} = \frac{hc}{\lambda_{\text{кр}}}$, $E_{\text{кин max}} = \frac{m\upsilon_{\text{max}}^2}{2} = eU_{\text{зап}}$</data>
</node>
