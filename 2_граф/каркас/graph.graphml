  <data key="d9">приказ</data>
  <data key="d18">Гипотеза М. Планка о квантах. Формула Планка: $E = h\nu$</data>
</node>
<node id="SOO.physics.ege.el.4.1.2">
  <data key="d0">exam_element</data>
  <data key="d1">4.1.2 h c Фотоны. Энергия фотона: . E = h  = = p c  E h  h Импульс фотона: p = = = c c </data>
  <data key="d2">physics</data>
  <data key="d3">SOO</data>
  <data key="d6">4.1.2</data>
  <data key="d7">h c Фотоны. Энергия фотона: . E = h  = = p c  E h  h Импульс фотона: p = = = c c </data>
  <data key="d8">1036</data>
  <data key="d9">приказ</data>
  <data key="d18">Фотоны. Энергия фотона: $E = h\nu = \frac{hc}{\lambda} = pc$. Импульс фотона: $p = \frac{E}{c} = \frac{h\nu}{c} = \frac{h}{\lambda}$</data>
</node>
<node id="SOO.physics.ege.el.4.1.3">
  <data key="d0">exam_element</data>
  <data key="d1">4.1.3 Фотоэффект. Опыты А.Г. Столетова. Законы фотоэффекта</data>
