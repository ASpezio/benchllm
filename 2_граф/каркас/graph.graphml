  <data key="d0">exam_element</data>
  <data key="d1">3.10 Работа и мощность электрического тока. A = U  I  t ; P = U  I</data>
  <data key="d2">physics</data>
  <data key="d3">OOO</data>
  <data key="d6">3.10</data>
  <data key="d7">Работа и мощность электрического тока. A = U  I  t ; P = U  I</data>
  <data key="d8">597</data>
  <data key="d9">приказ</data>
  <data key="d18">Работа и мощность электрического тока. $A = U \cdot I \cdot t; P = U \cdot I$</data>
</node>
