    <edge id="e9067" source="C.physics.issledovanie-nezavisimosti-vytalkivayuschey-sily-ot-massy-tela" target="C.physics.zakon-arhimeda"><data key="e_type">verifies</data><data key="e_why">проверяется, что сила не зависит от массы тела</data></edge>
