    <edge id="e8027" source="C.history.proizvodstvo-metallov" target="C.history.izmeneniya-v-evropeyskom-obschestve-v-xvi-xvii-vekah"><data key="e_type">part_of</data><data key="e_why">рост металлургии — одно из изменений</data></edge>
