    <edge id="e8970" source="C.physics.skorost" target="C.physics.temperatura"><data key="e_order_issue">True</data><data key="e_type">prerequisites_for</data><data key="e_why">связь температуры со скоростью частиц требует понятия скорости (вводится в 3.2)</data></edge>
    <edge id="e8971" source="C.physics.molekula" target="C.physics.vzaimodeystvie-chastits-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">взаимодействуют молекулы и атомы вещества</data></edge>
    <edge id="e8972" source="C.physics.ottalkivanie-chastits-veschestva" target="C.physics.vzaimodeystvie-chastits-veschestva"><data key="e_type">is_a</data><data key="e_why">отталкивание — вид взаимодействия частиц</data></edge>
    <edge id="e8973" source="C.physics.prityazhenie-chastits-veschestva" target="C.physics.vzaimodeystvie-chastits-veschestva"><data key="e_type">is_a</data><data key="e_why">притяжение — вид взаимодействия частиц</data></edge>
    <edge id="e8974" source="C.physics.stroenie-veschestva" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">агрегатные состояния различаются строением вещества</data></edge>
    <edge id="e8975" source="C.physics.vzaimodeystvie-chastits-veschestva" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">состояние определяется взаимодействием и расположением частиц</data></edge>
    <edge id="e8976" source="C.physics.gaz" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">газ — одно из агрегатных состояний</data></edge>
    <edge id="e8977" source="C.physics.zhidkost" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">жидкость — одно из агрегатных состояний</data></edge>
    <edge id="e8978" source="C.physics.tverdoe-telo" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">твёрдое тело — одно из агрегатных состояний</data></edge>
    <edge id="e8979" source="C.physics.agregatnye-sostoyaniya-vody" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">частный случай агрегатных состояний вещества</data></edge>
    <edge id="e8980" source="C.physics.nablyudenie-teplovogo-rasshireniya-gazov" target="C.physics.teplovoe-rasshirenie"><data key="e_type">verifies</data><data key="e_why">опыт демонстрирует расширение газа при нагревании</data></edge>
    <edge id="e8981" source="C.physics.obnaruzhenie-deystviya-sil-molekulyarnogo-prityazheniya" target="C.physics.prityazhenie-chastits-veschestva"><data key="e_type">verifies</data><data key="e_why">опыт обнаруживает притяжение молекул</data></edge>
    <edge id="e8982" source="C.physics.otsenka-diametra-atoma-metodom-ryadov" target="C.physics.razmery-atomov-i-molekul"><data key="e_type">verifies</data><data key="e_why">в работе оценивается размер атома</data></edge>
    <edge id="e8983" source="C.physics.opredelenie-razmerov-malyh-tel" target="C.physics.otsenka-diametra-atoma-metodom-ryadov"><data key="e_type">prerequisites_for</data><data key="e_why">используется метод рядов, освоенный при измерении малых тел</data></edge>
    <edge id="e8984" source="C.physics.mehanicheskoe-dvizhenie" target="C.physics.mehanicheskie-yavleniya"><data key="e_type">is_a</data><data key="e_why">механическое движение — механическое явление</data></edge>
    <edge id="e8985" source="C.physics.neravnomernoe-dvizhenie" target="C.physics.mehanicheskoe-dvizhenie"><data key="e_type">is_a</data><data key="e_why">вид механического движения</data></edge>
    <edge id="e8986" source="C.physics.ravnomernoe-dvizhenie" target="C.physics.mehanicheskoe-dvizhenie"><data key="e_type">is_a</data><data key="e_why">вид механического движения</data></edge>
    <edge id="e8987" source="C.physics.mehanicheskoe-dvizhenie" target="C.physics.put"><data key="e_type">prerequisites_for</data><data key="e_why">путь — длина траектории движущегося тела</data></edge>
    <edge id="e8988" source="C.physics.mehanicheskoe-dvizhenie" target="C.physics.vremya-dvizheniya"><data key="e_type">prerequisites_for</data><data key="e_why">время движения характеризует механическое движение</data></edge>
    <edge id="e8989" source="C.physics.put" target="C.physics.skorost"><data key="e_type">prerequisites_for</data><data key="e_why">скорость — путь, пройденный за единицу времени</data></edge>
    <edge id="e8990" source="C.physics.vremya-dvizheniya" target="C.physics.skorost"><data key="e_type">prerequisites_for</data><data key="e_why">скорость определяется через время движения</data></edge>
    <edge id="e8991" source="C.physics.srednyaya-skorost" target="C.physics.skorost"><data key="e_type">is_a</data><data key="e_why">средняя скорость — вид скорости</data></edge>
    <edge id="e8992" source="C.physics.neravnomernoe-dvizhenie" target="C.physics.srednyaya-skorost"><data key="e_type">prerequisites_for</data><data key="e_why">средняя скорость характеризует неравномерное движение</data></edge>
    <edge id="e8993" source="C.physics.vzaimodeystvie-tel" target="C.physics.inertsiya"><data key="e_type">prerequisites_for</data><data key="e_why">инерция — сохранение скорости при отсутствии действия других тел</data></edge>
    <edge id="e8994" source="C.physics.skorost" target="C.physics.inertsiya"><data key="e_type">prerequisites_for</data><data key="e_why">инерция — сохранение скорости тела</data></edge>
    <edge id="e8995" source="C.physics.inertsiya" target="C.physics.zakon-inertsii"><data key="e_type">prerequisites_for</data><data key="e_why">закон инерции обобщает явление инерции</data></edge>
    <edge id="e8996" source="C.physics.ravnomernoe-dvizhenie" target="C.physics.zakon-inertsii"><data key="e_type">prerequisites_for</data><data key="e_why">без действия других тел тело движется равномерно и прямолинейно</data></edge>
    <edge id="e8997" source="C.physics.vzaimodeystvie-tel" target="C.physics.inertnost"><data key="e_type">prerequisites_for</data><data key="e_why">инертность проявляется в изменении скорости при взаимодействии</data></edge>
    <edge id="e8998" source="C.physics.skorost" target="C.physics.inertnost"><data key="e_type">prerequisites_for</data><data key="e_why">инертность определяет, как быстро меняется скорость тела</data></edge>
    <edge id="e8999" source="C.physics.inertnost" target="C.physics.massa"><data key="e_type">prerequisites_for</data><data key="e_why">масса — мера инертности тела</data></edge>
    <edge id="e9000" source="C.physics.massa" target="C.physics.plotnost-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">плотность определяется через массу и объём</data></edge>
    <edge id="e9001" source="C.physics.obem" target="C.physics.plotnost-veschestva"><data key="e_order_issue">True</data><data key="e_type">prerequisites_for</data><data key="e_why">ρ = m/V, но «Объём» как понятие появляется лишь в 4.2</data></edge>
    <edge id="e9002" source="C.physics.molekula" target="C.physics.kolichestvo-molekul-v-edinitse-obema"><data key="e_type">prerequisites_for</data><data key="e_why">подсчитываются молекулы в единице объёма</data></edge>
    <edge id="e9003" source="C.physics.kolichestvo-molekul-v-edinitse-obema" target="C.physics.plotnost-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">плотность связана с числом молекул в единице объёма</data></edge>
    <edge id="e9004" source="C.physics.vzaimodeystvie-tel" target="C.physics.sila"><data key="e_type">prerequisites_for</data><data key="e_why">сила — характеристика взаимодействия тел</data></edge>
    <edge id="e9005" source="C.physics.sila-uprugosti" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">сила упругости — вид силы</data></edge>
    <edge id="e9006" source="C.physics.sila-uprugosti" target="C.physics.zakon-guka"><data key="e_type">prerequisites_for</data><data key="e_why">закон Гука описывает силу упругости</data></edge>
    <edge id="e9007" source="C.physics.zakon-guka" target="C.physics.dinamometr"><data key="e_type">prerequisites_for</data><data key="e_why">действие динамометра основано на законе Гука</data></edge>
    <edge id="e9008" source="C.physics.dinamometr" target="C.physics.fizicheskiy-pribor"><data key="e_type">is_a</data><data key="e_why">динамометр — измерительный прибор</data></edge>
    <edge id="e9009" source="C.physics.ves-tela" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">вес — сила, с которой тело действует на опору или подвес</data></edge>
    <edge id="e9010" source="C.physics.sila-tyazhesti" target="C.physics.ves-tela"><data key="e_type">prerequisites_for</data><data key="e_why">вес возникает из-за притяжения тела к Земле</data></edge>
    <edge id="e9011" source="C.physics.ves-tela" target="C.physics.nevesomost"><data key="e_type">prerequisites_for</data><data key="e_why">невесомость — состояние, при котором вес тела равен нулю</data></edge>
    <edge id="e9012" source="C.physics.vsemirnoe-tyagotenie" target="C.physics.vzaimodeystvie-tel"><data key="e_type">is_a</data><data key="e_why">тяготение — взаимное притяжение тел</data></edge>
    <edge id="e9013" source="C.physics.vsemirnoe-tyagotenie" target="C.physics.sila-tyazhesti"><data key="e_type">prerequisites_for</data><data key="e_why">сила тяжести — проявление всемирного тяготения</data></edge>
    <edge id="e9014" source="C.physics.massa" target="C.physics.sila-tyazhesti"><data key="e_type">prerequisites_for</data><data key="e_why">F = mg: сила тяжести пропорциональна массе</data></edge>
    <edge id="e9015" source="C.physics.sila-tyazhesti" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">сила тяжести — вид силы</data></edge>
    <edge id="e9016" source="C.physics.trenie" target="C.physics.vzaimodeystvie-tel"><data key="e_type">is_a</data><data key="e_why">трение — взаимодействие соприкасающихся тел</data></edge>
    <edge id="e9017" source="C.physics.trenie" target="C.physics.sila-treniya"><data key="e_type">prerequisites_for</data><data key="e_why">сила трения характеризует трение</data></edge>
    <edge id="e9018" source="C.physics.sila-treniya" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">сила трения — вид силы</data></edge>
    <edge id="e9019" source="C.physics.trenie-pokoya" target="C.physics.trenie"><data key="e_type">is_a</data><data key="e_why">вид трения</data></edge>
    <edge id="e9020" source="C.physics.trenie-skolzheniya" target="C.physics.trenie"><data key="e_type">is_a</data><data key="e_why">вид трения</data></edge>
    <edge id="e9021" source="C.physics.sila" target="C.physics.slozhenie-sil"><data key="e_type">prerequisites_for</data><data key="e_why">складываются силы</data></edge>
    <edge id="e9022" source="C.physics.slozhenie-sil" target="C.physics.ravnodeystvuyuschaya-sil"><data key="e_type">prerequisites_for</data><data key="e_why">равнодействующая — результат сложения сил</data></edge>
    <edge id="e9023" source="C.physics.issledovanie-zavisimosti-rastyazheniya-pruzhiny-ot-prilozhennoy-sily" target="C.physics.zakon-guka"><data key="e_type">verifies</data><data key="e_why">исследуется пропорциональность удлинения пружины силе</data></edge>
    <edge id="e9024" source="C.physics.issledovanie-zavisimosti-sily-treniya-skolzheniya-ot-vesa-tela-i-haraktera-pover" target="C.physics.sila-treniya"><data key="e_type">verifies</data><data key="e_why">исследуется, от чего зависит сила трения скольжения</data></edge>
    <edge id="e9025" source="C.physics.ves-tela" target="C.physics.issledovanie-zavisimosti-sily-treniya-skolzheniya-ot-vesa-tela-i-haraktera-pover"><data key="e_type">prerequisites_for</data><data key="e_why">исследуется зависимость силы трения от веса тела</data></edge>
    <edge id="e9026" source="C.physics.dinamometr" target="C.physics.issledovanie-zavisimosti-sily-treniya-skolzheniya-ot-vesa-tela-i-haraktera-pover"><data key="e_type">prerequisites_for</data><data key="e_why">силу трения измеряют динамометром</data></edge>
    <edge id="e9027" source="C.physics.opredelenie-plotnosti-tverdogo-tela" target="C.physics.plotnost-veschestva"><data key="e_type">verifies</data><data key="e_why">в работе определяется плотность</data></edge>
    <edge id="e9028" source="C.physics.izmerenie-obema-zhidkosti-i-tverdogo-tela" target="C.physics.opredelenie-plotnosti-tverdogo-tela"><data key="e_type">prerequisites_for</data><data key="e_why">для расчёта плотности нужно измерить объём тела</data></edge>
    <edge id="e9029" source="C.physics.opredelenie-skorosti-ravnomernogo-dvizheniya" target="C.physics.skorost"><data key="e_type">verifies</data><data key="e_why">в работе измеряется скорость</data></edge>
    <edge id="e9030" source="C.physics.opredelenie-sredney-skorosti-skolzheniya-po-naklonnoy-ploskosti" target="C.physics.srednyaya-skorost"><data key="e_type">verifies</data><data key="e_why">в работе определяется средняя скорость</data></edge>
    <edge id="e9031" source="C.physics.dvizhenie-s-razlichnymi-skorostyami-v-zhivoy-i-nezhivoy-prirode" target="C.physics.mehanicheskoe-dvizhenie"><data key="e_type">is_a</data><data key="e_why">примеры механического движения в природе</data></edge>
    <edge id="e9032" source="C.physics.skorost" target="C.physics.dvizhenie-s-razlichnymi-skorostyami-v-zhivoy-i-nezhivoy-prirode"><data key="e_type">prerequisites_for</data><data key="e_why">примеры сравниваются по скорости движения</data></edge>
    <edge id="e9033" source="C.physics.trenie-v-prirode-i-tehnike" target="C.physics.trenie"><data key="e_type">is_a</data><data key="e_why">проявления трения в природе и технике</data></edge>
    <edge id="e9034" source="C.physics.trenie-skolzheniya" target="C.physics.podshipnik"><data key="e_type">prerequisites_for</data><data key="e_why">подшипник заменяет трение скольжения трением качения</data></edge>
    <edge id="e9035" source="C.physics.sila" target="C.physics.davlenie-tverdogo-tela"><data key="e_type">prerequisites_for</data><data key="e_why">давление — сила, действующая на единицу площади опоры</data></edge>
    <edge id="e9036" source="C.physics.davlenie-tverdogo-tela" target="C.physics.sposoby-umensheniya-i-uvelicheniya-davleniya"><data key="e_type">prerequisites_for</data><data key="e_why">давление меняют, изменяя силу или площадь опоры</data></edge>
    <edge id="e9037" source="C.physics.davlenie-tverdogo-tela" target="C.physics.davlenie-gaza"><data key="e_type">prerequisites_for</data><data key="e_why">давление определяется как сила на единицу площади</data></edge>
    <edge id="e9038" source="C.physics.dvizhenie-chastits-veschestva" target="C.physics.davlenie-gaza"><data key="e_type">prerequisites_for</data><data key="e_why">давление газа создаётся ударами молекул</data></edge>
    <edge id="e9039" source="C.physics.davlenie-gaza" target="C.physics.peredacha-davleniya"><data key="e_type">prerequisites_for</data><data key="e_why">газы и жидкости передают давление по всем направлениям</data></edge>
    <edge id="e9040" source="C.physics.peredacha-davleniya" target="C.physics.zakon-paskalya"><data key="e_type">prerequisites_for</data><data key="e_why">закон Паскаля описывает передачу давления жидкостями и газами</data></edge>
    <edge id="e9041" source="C.physics.zakon-paskalya" target="C.physics.pnevmaticheskaya-mashina"><data key="e_type">prerequisites_for</data><data key="e_why">работа пневматических машин основана на законе Паскаля</data></edge>
    <edge id="e9042" source="C.physics.zakon-paskalya" target="C.physics.gidravlicheskiy-mehanizm"><data key="e_type">prerequisites_for</data><data key="e_why">гидравлические механизмы основаны на законе Паскаля</data></edge>
    <edge id="e9043" source="C.physics.zakon-paskalya" target="C.physics.davlenie-zhidkosti"><data key="e_type">prerequisites_for</data><data key="e_why">давление в жидкости на данной глубине одинаково по всем направлениям</data></edge>
    <edge id="e9044" source="C.physics.plotnost-veschestva" target="C.physics.davlenie-zhidkosti"><data key="e_type">prerequisites_for</data><data key="e_why">p = ρgh: давление зависит от плотности жидкости</data></edge>
    <edge id="e9045" source="C.physics.ves-tela" target="C.physics.davlenie-zhidkosti"><data key="e_type">prerequisites_for</data><data key="e_why">давление создаётся весом столба жидкости</data></edge>
    <edge id="e9046" source="C.physics.atmosfernoe-davlenie" target="C.physics.davlenie-zhidkosti"><data key="e_order_issue">True</data><data key="e_type">prerequisites_for</data><data key="e_why">p = p₀ + ρgh включает атмосферное давление, вводимое лишь в 4.5</data></edge>
    <edge id="e9047" source="C.physics.davlenie-zhidkosti" target="C.physics.gidrostaticheskiy-paradoks"><data key="e_type">prerequisites_for</data><data key="e_why">давление на дно зависит только от высоты столба жидкости</data></edge>
    <edge id="e9048" source="C.physics.davlenie-zhidkosti" target="C.physics.soobschayuschiesya-sosudy"><data key="e_type">prerequisites_for</data><data key="e_why">равенство уровней следует из равенства давлений на одной глубине</data></edge>
    <edge id="e9049" source="C.physics.sila-tyazhesti" target="C.physics.atmosfera-zemli"><data key="e_type">prerequisites_for</data><data key="e_why">атмосферу удерживает сила тяжести</data></edge>
    <edge id="e9050" source="C.physics.dvizhenie-chastits-veschestva" target="C.physics.atmosfera-zemli"><data key="e_type">prerequisites_for</data><data key="e_why">движение молекул не даёт воздуху осесть на Землю</data></edge>
    <edge id="e9051" source="C.physics.atmosfera-zemli" target="C.physics.atmosfernoe-davlenie"><data key="e_type">prerequisites_for</data><data key="e_why">атмосферное давление создаётся воздушной оболочкой Земли</data></edge>
    <edge id="e9052" source="C.physics.davlenie-gaza" target="C.physics.atmosfernoe-davlenie"><data key="e_type">prerequisites_for</data><data key="e_why">атмосферное давление — давление газа (воздуха)</data></edge>
    <edge id="e9053" source="C.physics.opyt-torrichelli" target="C.physics.atmosfernoe-davlenie"><data key="e_type">verifies</data><data key="e_why">опыт Торричелли измеряет атмосферное давление</data></edge>
    <edge id="e9054" source="C.physics.davlenie-zhidkosti" target="C.physics.opyt-torrichelli"><data key="e_type">prerequisites_for</data><data key="e_why">давление столба ртути уравновешивает атмосферное</data></edge>
    <edge id="e9055" source="C.physics.atmosfernoe-davlenie" target="C.physics.barometr"><data key="e_type">prerequisites_for</data><data key="e_why">барометр измеряет атмосферное давление</data></edge>
