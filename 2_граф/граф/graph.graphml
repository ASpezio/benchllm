    <edge id="e9065" source="C.physics.ves-tela" target="C.physics.issledovanie-zavisimosti-vesa-tela-v-vode-ot-obema-pogruzhennoy-chasti-tela"><data key="e_type">prerequisites_for</data><data key="e_why">исследуется вес тела в воде</data></edge>
