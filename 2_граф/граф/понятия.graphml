    <edge id="e583" source="C.history.srednevekovyy-vostok" target="C.history.poiski-evropeytsami-morskih-putey-v-strany-vostoka"><data key="e_type">prerequisites_for</data><data key="e_why">искали путь к богатствам стран Востока</data></edge>
