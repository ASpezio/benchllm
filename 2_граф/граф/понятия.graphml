    <edge id="e628" source="C.history.m-lyuter" target="C.history.nachalo-reformatsii-v-germanii"><data key="e_type">participant_of</data><data key="e_why">начал Реформацию своими тезисами</data></edge>
    <edge id="e629" source="C.history.reformatsiya" target="C.history.krestyanskaya-voyna-v-germanii"><data key="e_type">prerequisites_for</data><data key="e_why">война развернулась на волне Реформации</data></edge>
