    <edge id="e600" source="C.history.poyavlenie-evropeyskih-zavoevateley-v-amerike" target="C.history.zavoevaniya-konkistadorov-v-amerike"><data key="e_type">part_of</data><data key="e_why">появление завоевателей — начало конкисты</data></edge>
