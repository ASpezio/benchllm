    <edge id="e592" source="C.history.fernan-magellan" target="C.history.krugosvetnoe-plavanie-magellana"><data key="e_type">participant_of</data><data key="e_why">возглавил экспедицию</data></edge>
    <edge id="e593" source="C.history.otkrytie-avstralii" target="C.history.velikie-geograficheskie-otkrytiya"><data key="e_type">part_of</data><data key="e_why">эпизод Великих открытий</data></edge>
    <edge id="e594" source="C.history.abel-tasman" target="C.history.otkrytie-avstralii"><data key="e_type">participant_of</data><data key="e_why">его плавания открыли Австралию</data></edge>
