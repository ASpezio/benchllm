    <edge id="e612" source="C.history.naemnyy-trud" target="C.history.kapitalisticheskie-otnosheniya"><data key="e_type">prerequisites_for</data><data key="e_why">капитализм основан на наёмном труде</data></edge>
    <edge id="e613" source="C.history.kapitalisticheskie-otnosheniya" target="C.history.izmeneniya-v-evropeyskom-obschestve-v-xvi-xvii-vekah"><data key="e_type">prerequisites_for</data><data key="e_why">капитализм — главная причина изменений</data></edge>
    <edge id="e614" source="C.history.torgovlya" target="C.history.vnutrenniy-rynok"><data key="e_type">prerequisites_for</data><data key="e_why">рынок складывается из торговли</data></edge>
    <edge id="e615" source="C.history.vnutrenniy-rynok" target="C.history.mirovoy-rynok"><data key="e_type">prerequisites_for</data><data key="e_why">мировой рынок связывает внутренние рынки стран</data></edge>
