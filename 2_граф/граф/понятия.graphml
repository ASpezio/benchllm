    <edge id="e619" source="C.history.novye-sotsialnye-gruppy" target="C.history.izmeneniya-v-evropeyskom-obschestve-v-xvi-xvii-vekah"><data key="e_type">part_of</data><data key="e_why">появление новых групп — одно из изменений</data></edge>
    <edge id="e620" source="C.history.povsednevnaya-zhizn-evropeytsev-v-xvi-xvii-vekah" target="C.history.izmeneniya-v-evropeyskom-obschestve-v-xvi-xvii-vekah"><data key="e_type">part_of</data><data key="e_why">быт показывает изменения общества</data></edge>
