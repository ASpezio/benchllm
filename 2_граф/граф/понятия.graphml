    <edge id="e608" source="C.history.proizvodstvo-metallov" target="C.history.izmeneniya-v-evropeyskom-obschestve-v-xvi-xvii-vekah"><data key="e_type">part_of</data><data key="e_why">рост металлургии — одно из изменений</data></edge>
    <edge id="e609" source="C.history.razvitie-tehniki" target="C.history.proizvodstvo-metallov"><data key="e_type">prerequisites_for</data><data key="e_why">новая техника подняла производство металлов</data></edge>
    <edge id="e610" source="C.history.remeslo" target="C.history.manufaktura"><data key="e_type">prerequisites_for</data><data key="e_why">мануфактура выросла из ремесла с разделением труда</data></edge>
