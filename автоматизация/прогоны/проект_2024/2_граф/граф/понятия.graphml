    <edge id="e474" source="C.physics.obem" target="C.physics.plotnost-veschestva"><data key="e_order_issue">True</data><data key="e_type">prerequisites_for</data><data key="e_why">ρ = m/V, но «Объём» как понятие появляется лишь в 4.2</data></edge>
    <edge id="e475" source="C.physics.kolichestvo-molekul-v-edinitse-obema" target="C.physics.plotnost-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">плотность связана с числом молекул в единице объёма</data></edge>
    <edge id="e476" source="C.physics.vzaimodeystvie-tel" target="C.physics.sila"><data key="e_type">prerequisites_for</data><data key="e_why">сила — характеристика взаимодействия тел</data></edge>
    <edge id="e477" source="C.physics.zakon-guka" target="C.physics.dinamometr"><data key="e_type">prerequisites_for</data><data key="e_why">действие динамометра основано на законе Гука</data></edge>
    <edge id="e478" source="C.physics.dinamometr" target="C.physics.fizicheskiy-pribor"><data key="e_type">is_a</data><data key="e_why">динамометр — измерительный прибор</data></edge>
    <edge id="e479" source="C.physics.sila-uprugosti" target="C.physics.zakon-guka"><data key="e_type">prerequisites_for</data><data key="e_why">закон Гука описывает силу упругости</data></edge>
    <edge id="e480" source="C.physics.sila-uprugosti" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">сила упругости — вид силы</data></edge>
    <edge id="e481" source="C.physics.ves-tela" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">вес — сила, с которой тело действует на опору или подвес</data></edge>
    <edge id="e482" source="C.physics.sila-tyazhesti" target="C.physics.ves-tela"><data key="e_type">prerequisites_for</data><data key="e_why">вес возникает из-за притяжения тела к Земле</data></edge>
    <edge id="e483" source="C.physics.vsemirnoe-tyagotenie" target="C.physics.vzaimodeystvie-tel"><data key="e_type">is_a</data><data key="e_why">тяготение — взаимное притяжение тел</data></edge>
    <edge id="e484" source="C.physics.ves-tela" target="C.physics.nevesomost"><data key="e_type">prerequisites_for</data><data key="e_why">невесомость — состояние, при котором вес тела равен нулю</data></edge>
    <edge id="e485" source="C.physics.vsemirnoe-tyagotenie" target="C.physics.sila-tyazhesti"><data key="e_type">prerequisites_for</data><data key="e_why">сила тяжести — проявление всемирного тяготения</data></edge>
    <edge id="e486" source="C.physics.massa" target="C.physics.sila-tyazhesti"><data key="e_type">prerequisites_for</data><data key="e_why">F = mg: сила тяжести пропорциональна массе</data></edge>
    <edge id="e487" source="C.physics.sila-tyazhesti" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">сила тяжести — вид силы</data></edge>
    <edge id="e488" source="C.physics.trenie" target="C.physics.sila-treniya"><data key="e_type">prerequisites_for</data><data key="e_why">сила трения характеризует трение</data></edge>
    <edge id="e489" source="C.physics.sila-treniya" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">сила трения — вид силы</data></edge>
    <edge id="e490" source="C.physics.trenie" target="C.physics.vzaimodeystvie-tel"><data key="e_type">is_a</data><data key="e_why">трение — взаимодействие соприкасающихся тел</data></edge>
    <edge id="e491" source="C.physics.trenie-pokoya" target="C.physics.trenie"><data key="e_type">is_a</data><data key="e_why">вид трения</data></edge>
    <edge id="e492" source="C.physics.trenie-skolzheniya" target="C.physics.trenie"><data key="e_type">is_a</data><data key="e_why">вид трения</data></edge>
    <edge id="e493" source="C.physics.slozhenie-sil" target="C.physics.ravnodeystvuyuschaya-sil"><data key="e_type">prerequisites_for</data><data key="e_why">равнодействующая — результат сложения сил</data></edge>
    <edge id="e494" source="C.physics.sila" target="C.physics.slozhenie-sil"><data key="e_type">prerequisites_for</data><data key="e_why">складываются силы</data></edge>
    <edge id="e495" source="C.physics.issledovanie-zavisimosti-rastyazheniya-pruzhiny-ot-prilozhennoy-sily" target="C.physics.zakon-guka"><data key="e_type">verifies</data><data key="e_why">исследуется пропорциональность удлинения пружины силе</data></edge>
    <edge id="e496" source="C.physics.issledovanie-zavisimosti-sily-treniya-skolzheniya-ot-vesa-tela-i-haraktera-pover" target="C.physics.sila-treniya"><data key="e_type">verifies</data><data key="e_why">исследуется, от чего зависит сила трения скольжения</data></edge>
    <edge id="e497" source="C.physics.ves-tela" target="C.physics.issledovanie-zavisimosti-sily-treniya-skolzheniya-ot-vesa-tela-i-haraktera-pover"><data key="e_type">prerequisites_for</data><data key="e_why">исследуется зависимость силы трения от веса тела</data></edge>
    <edge id="e498" source="C.physics.dinamometr" target="C.physics.issledovanie-zavisimosti-sily-treniya-skolzheniya-ot-vesa-tela-i-haraktera-pover"><data key="e_type">prerequisites_for</data><data key="e_why">силу трения измеряют динамометром</data></edge>
    <edge id="e499" source="C.physics.opredelenie-plotnosti-tverdogo-tela" target="C.physics.plotnost-veschestva"><data key="e_type">verifies</data><data key="e_why">в работе определяется плотность</data></edge>
    <edge id="e500" source="C.physics.izmerenie-obema-zhidkosti-i-tverdogo-tela" target="C.physics.opredelenie-plotnosti-tverdogo-tela"><data key="e_type">prerequisites_for</data><data key="e_why">для расчёта плотности нужно измерить объём тела</data></edge>
    <edge id="e501" source="C.physics.opredelenie-skorosti-ravnomernogo-dvizheniya" target="C.physics.skorost"><data key="e_type">verifies</data><data key="e_why">в работе измеряется скорость</data></edge>
    <edge id="e502" source="C.physics.opredelenie-sredney-skorosti-skolzheniya-po-naklonnoy-ploskosti" target="C.physics.srednyaya-skorost"><data key="e_type">verifies</data><data key="e_why">в работе определяется средняя скорость</data></edge>
    <edge id="e503" source="C.physics.dvizhenie-s-razlichnymi-skorostyami-v-zhivoy-i-nezhivoy-prirode" target="C.physics.mehanicheskoe-dvizhenie"><data key="e_type">is_a</data><data key="e_why">примеры механического движения в природе</data></edge>
    <edge id="e504" source="C.physics.skorost" target="C.physics.dvizhenie-s-razlichnymi-skorostyami-v-zhivoy-i-nezhivoy-prirode"><data key="e_type">prerequisites_for</data><data key="e_why">примеры сравниваются по скорости движения</data></edge>
    <edge id="e505" source="C.physics.trenie-v-prirode-i-tehnike" target="C.physics.trenie"><data key="e_type">is_a</data><data key="e_why">проявления трения в природе и технике</data></edge>
    <edge id="e506" source="C.physics.trenie-skolzheniya" target="C.physics.podshipnik"><data key="e_type">prerequisites_for</data><data key="e_why">подшипник заменяет трение скольжения трением качения</data></edge>
    <edge id="e507" source="C.physics.sila" target="C.physics.davlenie-tverdogo-tela"><data key="e_type">prerequisites_for</data><data key="e_why">давление — сила, действующая на единицу площади опоры</data></edge>
    <edge id="e508" source="C.physics.davlenie-tverdogo-tela" target="C.physics.sposoby-umensheniya-i-uvelicheniya-davleniya"><data key="e_type">prerequisites_for</data><data key="e_why">давление меняют, изменяя силу или площадь опоры</data></edge>
    <edge id="e509" source="C.physics.davlenie-tverdogo-tela" target="C.physics.davlenie-gaza"><data key="e_type">prerequisites_for</data><data key="e_why">давление определяется как сила на единицу площади</data></edge>
    <edge id="e510" source="C.physics.dvizhenie-chastits-veschestva" target="C.physics.davlenie-gaza"><data key="e_type">prerequisites_for</data><data key="e_why">давление газа создаётся ударами молекул</data></edge>
    <edge id="e511" source="C.physics.peredacha-davleniya" target="C.physics.zakon-paskalya"><data key="e_type">prerequisites_for</data><data key="e_why">закон Паскаля описывает передачу давления жидкостями и газами</data></edge>
    <edge id="e512" source="C.physics.davlenie-gaza" target="C.physics.peredacha-davleniya"><data key="e_type">prerequisites_for</data><data key="e_why">газы и жидкости передают давление по всем направлениям</data></edge>
    <edge id="e513" source="C.physics.zakon-paskalya" target="C.physics.pnevmaticheskaya-mashina"><data key="e_type">prerequisites_for</data><data key="e_why">работа пневматических машин основана на законе Паскаля</data></edge>
    <edge id="e514" source="C.physics.zakon-paskalya" target="C.physics.gidravlicheskiy-mehanizm"><data key="e_type">prerequisites_for</data><data key="e_why">гидравлические механизмы основаны на законе Паскаля</data></edge>
    <edge id="e515" source="C.physics.davlenie-zhidkosti" target="C.physics.gidrostaticheskiy-paradoks"><data key="e_type">prerequisites_for</data><data key="e_why">давление на дно зависит только от высоты столба жидкости</data></edge>
    <edge id="e516" source="C.physics.zakon-paskalya" target="C.physics.davlenie-zhidkosti"><data key="e_type">prerequisites_for</data><data key="e_why">давление в жидкости на данной глубине одинаково по всем направлениям</data></edge>
    <edge id="e517" source="C.physics.plotnost-veschestva" target="C.physics.davlenie-zhidkosti"><data key="e_type">prerequisites_for</data><data key="e_why">p = ρgh: давление зависит от плотности жидкости</data></edge>
    <edge id="e518" source="C.physics.ves-tela" target="C.physics.davlenie-zhidkosti"><data key="e_type">prerequisites_for</data><data key="e_why">давление создаётся весом столба жидкости</data></edge>
    <edge id="e519" source="C.physics.atmosfernoe-davlenie" target="C.physics.davlenie-zhidkosti"><data key="e_order_issue">True</data><data key="e_type">prerequisites_for</data><data key="e_why">p = p₀ + ρgh включает атмосферное давление, вводимое лишь в 4.5</data></edge>
    <edge id="e520" source="C.physics.davlenie-zhidkosti" target="C.physics.soobschayuschiesya-sosudy"><data key="e_type">prerequisites_for</data><data key="e_why">равенство уровней следует из равенства давлений на одной глубине</data></edge>
    <edge id="e521" source="C.physics.sila-tyazhesti" target="C.physics.atmosfera-zemli"><data key="e_type">prerequisites_for</data><data key="e_why">атмосферу удерживает сила тяжести</data></edge>
    <edge id="e522" source="C.physics.dvizhenie-chastits-veschestva" target="C.physics.atmosfera-zemli"><data key="e_type">prerequisites_for</data><data key="e_why">движение молекул не даёт воздуху осесть на Землю</data></edge>
    <edge id="e523" source="C.physics.atmosfera-zemli" target="C.physics.atmosfernoe-davlenie"><data key="e_type">prerequisites_for</data><data key="e_why">атмосферное давление создаётся воздушной оболочкой Земли</data></edge>
    <edge id="e524" source="C.physics.davlenie-gaza" target="C.physics.atmosfernoe-davlenie"><data key="e_type">prerequisites_for</data><data key="e_why">атмосферное давление — давление газа (воздуха)</data></edge>
    <edge id="e525" source="C.physics.opyt-torrichelli" target="C.physics.atmosfernoe-davlenie"><data key="e_type">verifies</data><data key="e_why">опыт Торричелли измеряет атмосферное давление</data></edge>
    <edge id="e526" source="C.physics.davlenie-zhidkosti" target="C.physics.opyt-torrichelli"><data key="e_type">prerequisites_for</data><data key="e_why">давление столба ртути уравновешивает атмосферное</data></edge>
    <edge id="e527" source="C.physics.atmosfernoe-davlenie" target="C.physics.barometr"><data key="e_type">prerequisites_for</data><data key="e_why">барометр измеряет атмосферное давление</data></edge>
    <edge id="e528" source="C.physics.barometr" target="C.physics.fizicheskiy-pribor"><data key="e_type">is_a</data><data key="e_why">барометр — измерительный прибор</data></edge>
    <edge id="e529" source="C.physics.vytalkivayuschaya-sila" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">выталкивающая сила — вид силы</data></edge>
    <edge id="e530" source="C.physics.davlenie-zhidkosti" target="C.physics.vytalkivayuschaya-sila"><data key="e_type">prerequisites_for</data><data key="e_why">сила возникает из-за разности давлений на разной глубине</data></edge>
    <edge id="e531" source="C.physics.vytalkivayuschaya-sila" target="C.physics.zakon-arhimeda"><data key="e_type">prerequisites_for</data><data key="e_why">закон Архимеда определяет выталкивающую силу</data></edge>
    <edge id="e532" source="C.physics.ves-tela" target="C.physics.zakon-arhimeda"><data key="e_type">prerequisites_for</data><data key="e_why">сила равна весу вытесненной жидкости или газа</data></edge>
    <edge id="e533" source="C.physics.plavanie-tel" target="C.physics.vozduhoplavanie"><data key="e_type">prerequisites_for</data><data key="e_why">воздухоплавание — плавание тел в воздухе</data></edge>
    <edge id="e534" source="C.physics.zakon-arhimeda" target="C.physics.plavanie-tel"><data key="e_type">prerequisites_for</data><data key="e_why">условие плавания следует из закона Архимеда</data></edge>
    <edge id="e535" source="C.physics.sila-tyazhesti" target="C.physics.plavanie-tel"><data key="e_type">prerequisites_for</data><data key="e_why">плавание — сравнение силы тяжести и архимедовой силы</data></edge>
    <edge id="e536" source="C.physics.issledovanie-zavisimosti-vesa-tela-v-vode-ot-obema-pogruzhennoy-chasti-tela" target="C.physics.vytalkivayuschaya-sila"><data key="e_type">verifies</data><data key="e_why">вес тела в воде уменьшается из-за выталкивающей силы</data></edge>
    <edge id="e537" source="C.physics.ves-tela" target="C.physics.issledovanie-zavisimosti-vesa-tela-v-vode-ot-obema-pogruzhennoy-chasti-tela"><data key="e_type">prerequisites_for</data><data key="e_why">исследуется вес тела в воде</data></edge>
    <edge id="e538" source="C.physics.issledovanie-zavisimosti-vytalkivayuschey-sily-ot-obema-pogruzhennoy-chasti-tela" target="C.physics.zakon-arhimeda"><data key="e_type">verifies</data><data key="e_why">проверяется зависимость F = ρgV</data></edge>
    <edge id="e539" source="C.physics.issledovanie-nezavisimosti-vytalkivayuschey-sily-ot-massy-tela" target="C.physics.zakon-arhimeda"><data key="e_type">verifies</data><data key="e_why">проверяется, что сила не зависит от массы тела</data></edge>
    <edge id="e540" source="C.physics.konstruirovanie-areometra" target="C.physics.plavanie-tel"><data key="e_type">verifies</data><data key="e_why">ареометр плавает, погружаясь по-разному в разные жидкости</data></edge>
    <edge id="e541" source="C.physics.areometr" target="C.physics.konstruirovanie-areometra"><data key="e_order_issue">True</data><data key="e_type">prerequisites_for</data><data key="e_why">конструируется ареометр, а прибор описан лишь в 4.11</data></edge>
    <edge id="e542" source="C.physics.konstruirovanie-lodki-i-opredelenie-ee-gruzopodemnosti" target="C.physics.plavanie-tel"><data key="e_type">verifies</data><data key="e_why">грузоподъёмность определяется условием плавания</data></edge>
    <edge id="e543" source="C.physics.opredelenie-vytalkivayuschey-sily" target="C.physics.vytalkivayuschaya-sila"><data key="e_type">verifies</data><data key="e_why">в работе измеряется выталкивающая сила</data></edge>
    <edge id="e544" source="C.physics.dinamometr" target="C.physics.opredelenie-vytalkivayuschey-sily"><data key="e_type">prerequisites_for</data><data key="e_why">выталкивающую силу находят по показаниям динамометра</data></edge>
    <edge id="e545" source="C.physics.atmosfernoe-davlenie" target="C.physics.vliyanie-atmosfernogo-davleniya-na-zhivoy-organizm"><data key="e_type">prerequisites_for</data><data key="e_why">явление объясняется действием атмосферного давления</data></edge>
    <edge id="e546" source="C.physics.plavanie-ryb" target="C.physics.plavanie-tel"><data key="e_type">is_a</data><data key="e_why">плавание рыб — частный случай плавания тел</data></edge>
    <edge id="e547" source="C.physics.plavanie-tel" target="C.physics.areometr"><data key="e_type">prerequisites_for</data><data key="e_why">ареометр работает по условию плавания тел</data></edge>
    <edge id="e548" source="C.physics.plotnost-veschestva" target="C.physics.areometr"><data key="e_type">prerequisites_for</data><data key="e_why">ареометр измеряет плотность жидкости</data></edge>
    <edge id="e549" source="C.physics.areometr" target="C.physics.fizicheskiy-pribor"><data key="e_type">is_a</data><data key="e_why">ареометр — измерительный прибор</data></edge>
    <edge id="e550" source="C.physics.soobschayuschiesya-sosudy" target="C.physics.vodoprovod"><data key="e_type">prerequisites_for</data><data key="e_why">водопровод работает по принципу сообщающихся сосудов</data></edge>
    <edge id="e551" source="C.physics.vysotomer" target="C.physics.barometr"><data key="e_type">is_a</data><data key="e_why">высотомер — барометр, проградуированный в единицах высоты</data></edge>
    <edge id="e552" source="C.physics.gidravlicheskiy-press" target="C.physics.gidravlicheskiy-mehanizm"><data key="e_type">is_a</data><data key="e_why">гидравлический пресс — вид гидравлического механизма</data></edge>
    <edge id="e553" source="C.physics.zakon-paskalya" target="C.physics.gidravlicheskiy-press"><data key="e_type">prerequisites_for</data><data key="e_why">пресс основан на законе Паскаля</data></edge>
    <edge id="e554" source="C.physics.davlenie-gaza" target="C.physics.manometr"><data key="e_type">prerequisites_for</data><data key="e_why">манометр измеряет давление газов</data></edge>
    <edge id="e555" source="C.physics.soobschayuschiesya-sosudy" target="C.physics.manometr"><data key="e_type">prerequisites_for</data><data key="e_why">жидкостный манометр — U-образные сообщающиеся сосуды</data></edge>
    <edge id="e556" source="C.physics.manometr" target="C.physics.fizicheskiy-pribor"><data key="e_type">is_a</data><data key="e_why">манометр — измерительный прибор</data></edge>
    <edge id="e557" source="C.physics.atmosfernoe-davlenie" target="C.physics.porshnevoy-nasos"><data key="e_type">prerequisites_for</data><data key="e_why">вода поднимается за поршнем под действием атмосферного давления</data></edge>
    <edge id="e558" source="C.physics.sila" target="C.physics.mehanicheskaya-rabota"><data key="e_type">prerequisites_for</data><data key="e_why">A = Fs: работу совершает сила</data></edge>
    <edge id="e559" source="C.physics.put" target="C.physics.mehanicheskaya-rabota"><data key="e_type">prerequisites_for</data><data key="e_why">работа зависит от пройденного пути</data></edge>
    <edge id="e560" source="C.physics.mehanicheskaya-rabota" target="C.physics.mehanicheskaya-moschnost"><data key="e_type">prerequisites_for</data><data key="e_why">мощность — работа за единицу времени</data></edge>
    <edge id="e561" source="C.physics.vremya-dvizheniya" target="C.physics.mehanicheskaya-moschnost"><data key="e_type">prerequisites_for</data><data key="e_why">N = A/t</data></edge>
    <edge id="e562" source="C.physics.blok" target="C.physics.prostye-mehanizmy"><data key="e_type">is_a</data><data key="e_why">блок — простой механизм</data></edge>
    <edge id="e563" source="C.physics.pravilo-ravnovesiya-rychaga" target="C.physics.blok"><data key="e_type">prerequisites_for</data><data key="e_why">блок рассматривается как разновидность рычага</data></edge>
    <edge id="e564" source="C.physics.naklonnaya-ploskost" target="C.physics.prostye-mehanizmy"><data key="e_type">is_a</data><data key="e_why">наклонная плоскость — простой механизм</data></edge>
    <edge id="e565" source="C.physics.rychag" target="C.physics.pravilo-ravnovesiya-rychaga"><data key="e_type">prerequisites_for</data><data key="e_why">правило описывает равновесие рычага</data></edge>
    <edge id="e566" source="C.physics.sila" target="C.physics.prostye-mehanizmy"><data key="e_type">prerequisites_for</data><data key="e_why">простые механизмы служат для преобразования силы</data></edge>
    <edge id="e567" source="C.physics.rychag" target="C.physics.prostye-mehanizmy"><data key="e_type">is_a</data><data key="e_why">рычаг — простой механизм</data></edge>
    <edge id="e568" source="C.physics.mehanicheskaya-rabota" target="C.physics.zolotoe-pravilo-mehaniki"><data key="e_type">prerequisites_for</data><data key="e_why">ни один механизм не даёт выигрыша в работе</data></edge>
    <edge id="e569" source="C.physics.prostye-mehanizmy" target="C.physics.zolotoe-pravilo-mehaniki"><data key="e_type">prerequisites_for</data><data key="e_why">правило относится к простым механизмам</data></edge>
    <edge id="e570" source="C.physics.mehanicheskaya-rabota" target="C.physics.koeffitsient-poleznogo-deystviya"><data key="e_type">prerequisites_for</data><data key="e_why">КПД — отношение полезной работы к полной</data></edge>
    <edge id="e571" source="C.physics.prostye-mehanizmy" target="C.physics.koeffitsient-poleznogo-deystviya"><data key="e_type">prerequisites_for</data><data key="e_why">вводится КПД механизмов</data></edge>
    <edge id="e572" source="C.physics.sila-tyazhesti" target="C.physics.potentsialnaya-energiya"><data key="e_type">prerequisites_for</data><data key="e_why">Ep = mgh определяется работой силы тяжести</data></edge>
    <edge id="e573" source="C.physics.mehanicheskaya-rabota" target="C.physics.potentsialnaya-energiya"><data key="e_type">prerequisites_for</data><data key="e_why">энергия — способность тела совершить работу</data></edge>
    <edge id="e574" source="C.physics.potentsialnaya-energiya" target="C.physics.mehanicheskaya-energiya"><data key="e_type">part_of</data><data key="e_why">E = Ek + Ep</data></edge>
    <edge id="e575" source="C.physics.massa" target="C.physics.kineticheskaya-energiya"><data key="e_type">prerequisites_for</data><data key="e_why">Ek = mv²/2</data></edge>
    <edge id="e576" source="C.physics.skorost" target="C.physics.kineticheskaya-energiya"><data key="e_type">prerequisites_for</data><data key="e_why">кинетическая энергия зависит от скорости</data></edge>
    <edge id="e577" source="C.physics.mehanicheskaya-rabota" target="C.physics.kineticheskaya-energiya"><data key="e_type">prerequisites_for</data><data key="e_why">энергия — способность тела совершить работу</data></edge>
    <edge id="e578" source="C.physics.kineticheskaya-energiya" target="C.physics.mehanicheskaya-energiya"><data key="e_type">part_of</data><data key="e_why">E = Ek + Ep</data></edge>
    <edge id="e579" source="C.physics.mehanicheskaya-energiya" target="C.physics.zakon-izmeneniya-mehanicheskoy-energii"><data key="e_type">prerequisites_for</data><data key="e_why">закон описывает изменение механической энергии</data></edge>
    <edge id="e580" source="C.physics.mehanicheskaya-rabota" target="C.physics.zakon-izmeneniya-mehanicheskoy-energii"><data key="e_type">prerequisites_for</data><data key="e_why">энергия меняется на работу внешних сил и сил трения</data></edge>
    <edge id="e581" source="C.physics.mehanicheskaya-energiya" target="C.physics.zakon-sohraneniya-mehanicheskoy-energii"><data key="e_type">prerequisites_for</data><data key="e_why">закон о сохранении полной механической энергии</data></edge>
    <edge id="e582" source="C.physics.zakon-sohraneniya-mehanicheskoy-energii" target="C.physics.zakon-izmeneniya-mehanicheskoy-energii"><data key="e_type">is_a</data><data key="e_why">частный случай, когда работа сил трения равна нулю</data></edge>
    <edge id="e583" source="C.physics.izmerenie-kpd-naklonnoy-ploskosti" target="C.physics.koeffitsient-poleznogo-deystviya"><data key="e_type">verifies</data><data key="e_why">в работе измеряется КПД</data></edge>
    <edge id="e584" source="C.physics.naklonnaya-ploskost" target="C.physics.izmerenie-kpd-naklonnoy-ploskosti"><data key="e_type">prerequisites_for</data><data key="e_why">КПД определяется для наклонной плоскости</data></edge>
    <edge id="e585" source="C.physics.izuchenie-zakona-sohraneniya-mehanicheskoy-energii" target="C.physics.zakon-sohraneniya-mehanicheskoy-energii"><data key="e_type">verifies</data><data key="e_why">проверяется сохранение механической энергии</data></edge>
    <edge id="e586" source="C.physics.issledovanie-usloviy-ravnovesiya-rychaga" target="C.physics.pravilo-ravnovesiya-rychaga"><data key="e_type">verifies</data><data key="e_why">проверяется правило равновесия рычага</data></edge>
    <edge id="e587" source="C.physics.opredelenie-raboty-sily-treniya" target="C.physics.mehanicheskaya-rabota"><data key="e_type">verifies</data><data key="e_why">в работе определяется работа силы</data></edge>
    <edge id="e588" source="C.physics.sila-treniya" target="C.physics.opredelenie-raboty-sily-treniya"><data key="e_type">prerequisites_for</data><data key="e_why">определяется работа именно силы трения</data></edge>
    <edge id="e589" source="C.physics.rychagi-v-tele-cheloveka" target="C.physics.rychag"><data key="e_type">is_a</data><data key="e_why">кости и суставы работают как рычаги</data></edge>
    <edge id="e590" source="C.physics.nepodvizhnyy-blok" target="C.physics.blok"><data key="e_type">is_a</data><data key="e_why">вид блока</data></edge>
    <edge id="e591" source="C.physics.podvizhnyy-blok" target="C.physics.blok"><data key="e_type">is_a</data><data key="e_why">вид блока</data></edge>
    <edge id="e592" source="C.physics.molekula" target="C.physics.massa-molekuly"><data key="e_type">prerequisites_for</data><data key="e_why">речь о массе отдельной молекулы</data></edge>
    <edge id="e593" source="C.physics.massa" target="C.physics.massa-molekuly"><data key="e_type">prerequisites_for</data><data key="e_why">используется понятие массы</data></edge>
    <edge id="e594" source="C.physics.stroenie-veschestva" target="C.physics.molekulyarno-kineticheskaya-teoriya"><data key="e_type">prerequisites_for</data><data key="e_why">МКТ — теория строения вещества</data></edge>
    <edge id="e595" source="C.physics.opyty-podtverzhdayuschie-molekulyarno-kineticheskuyu-teoriyu" target="C.physics.molekulyarno-kineticheskaya-teoriya"><data key="e_type">verifies</data><data key="e_why">опыты подтверждают положения МКТ</data></edge>
    <edge id="e596" source="C.physics.razmery-molekul" target="C.physics.razmery-atomov-i-molekul"><data key="e_type">is_a</data><data key="e_why">частный случай размеров атомов и молекул</data></edge>
    <edge id="e597" source="C.physics.amorfnye-tela" target="C.physics.tverdoe-telo"><data key="e_type">is_a</data><data key="e_why">аморфные тела — твёрдые тела без кристаллической решётки</data></edge>
    <edge id="e598" source="C.physics.kristallicheskie-tela" target="C.physics.amorfnye-tela"><data key="e_type">prerequisites_for</data><data key="e_why">аморфные тела определяются через отличие от кристаллических</data></edge>
    <edge id="e599" source="C.physics.kristallicheskie-tela" target="C.physics.tverdoe-telo"><data key="e_type">is_a</data><data key="e_why">кристаллические тела — твёрдые тела</data></edge>
    <edge id="e600" source="C.physics.model-tverdogo-sostoyaniya-veschestva" target="C.physics.kristallicheskie-tela"><data key="e_type">prerequisites_for</data><data key="e_why">кристаллическая решётка — модель строения твёрдого тела</data></edge>
    <edge id="e601" source="C.physics.model-gazoobraznogo-sostoyaniya-veschestva" target="C.physics.fizicheskaya-model"><data key="e_type">is_a</data><data key="e_why">модель газа — физическая модель</data></edge>
    <edge id="e602" source="C.physics.molekulyarno-kineticheskaya-teoriya" target="C.physics.model-gazoobraznogo-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">модель строится на положениях МКТ</data></edge>
    <edge id="e603" source="C.physics.gaz" target="C.physics.model-gazoobraznogo-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">модель описывает газообразное состояние</data></edge>
    <edge id="e604" source="C.physics.model-zhidkogo-sostoyaniya-veschestva" target="C.physics.fizicheskaya-model"><data key="e_type">is_a</data><data key="e_why">модель жидкости — физическая модель</data></edge>
    <edge id="e605" source="C.physics.molekulyarno-kineticheskaya-teoriya" target="C.physics.model-zhidkogo-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">модель строится на положениях МКТ</data></edge>
    <edge id="e606" source="C.physics.zhidkost" target="C.physics.model-zhidkogo-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">модель описывает жидкое состояние</data></edge>
    <edge id="e607" source="C.physics.model-tverdogo-sostoyaniya-veschestva" target="C.physics.fizicheskaya-model"><data key="e_type">is_a</data><data key="e_why">модель твёрдого тела — физическая модель</data></edge>
    <edge id="e608" source="C.physics.molekulyarno-kineticheskaya-teoriya" target="C.physics.model-tverdogo-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">модель строится на положениях МКТ</data></edge>
    <edge id="e609" source="C.physics.tverdoe-telo" target="C.physics.model-tverdogo-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">модель описывает твёрдое состояние</data></edge>
    <edge id="e610" source="C.physics.model-gazoobraznogo-sostoyaniya-veschestva" target="C.physics.svoystva-gazov"><data key="e_type">prerequisites_for</data><data key="e_why">свойства газов объясняются на основе модели</data></edge>
    <edge id="e611" source="C.physics.model-zhidkogo-sostoyaniya-veschestva" target="C.physics.svoystva-zhidkostey"><data key="e_type">prerequisites_for</data><data key="e_why">свойства жидкостей объясняются на основе модели</data></edge>
    <edge id="e612" source="C.physics.model-tverdogo-sostoyaniya-veschestva" target="C.physics.svoystva-tverdyh-tel"><data key="e_type">prerequisites_for</data><data key="e_why">свойства твёрдых тел объясняются на основе модели</data></edge>
    <edge id="e613" source="C.physics.smachivanie" target="C.physics.kapillyarnye-yavleniya"><data key="e_type">prerequisites_for</data><data key="e_why">подъём или опускание жидкости в капилляре зависит от смачивания</data></edge>
    <edge id="e614" source="C.physics.prityazhenie-chastits-veschestva" target="C.physics.smachivanie"><data key="e_type">prerequisites_for</data><data key="e_why">смачивание — результат притяжения молекул жидкости и твёрдого тела</data></edge>
    <edge id="e615" source="C.physics.temperatura" target="C.physics.teplovoe-rasshirenie"><data key="e_type">prerequisites_for</data><data key="e_why">размеры тел меняются при изменении температуры</data></edge>
    <edge id="e616" source="C.physics.teplovoe-rasshirenie" target="C.physics.teplovye-yavleniya"><data key="e_type">is_a</data><data key="e_why">тепловое расширение — тепловое явление</data></edge>
    <edge id="e617" source="C.physics.teplovoe-rasshirenie" target="C.physics.teplovoe-szhatie"><data key="e_type">prerequisites_for</data><data key="e_why">сжатие при охлаждении — процесс, обратный расширению</data></edge>
    <edge id="e618" source="C.physics.teplovoe-dvizhenie" target="C.physics.dvizhenie-chastits-veschestva"><data key="e_type">is_a</data><data key="e_why">тепловое движение — хаотическое движение частиц вещества</data></edge>
    <edge id="e619" source="C.physics.teplovoe-dvizhenie" target="C.physics.vnutrennyaya-energiya"><data key="e_type">prerequisites_for</data><data key="e_why">внутренняя энергия включает энергию теплового движения частиц</data></edge>
    <edge id="e620" source="C.physics.vzaimodeystvie-chastits-veschestva" target="C.physics.vnutrennyaya-energiya"><data key="e_type">prerequisites_for</data><data key="e_why">внутренняя энергия включает энергию взаимодействия частиц</data></edge>
    <edge id="e621" source="C.physics.kineticheskaya-energiya" target="C.physics.vnutrennyaya-energiya"><data key="e_type">prerequisites_for</data><data key="e_why">кинетическая энергия частиц — слагаемое внутренней энергии</data></edge>
    <edge id="e622" source="C.physics.potentsialnaya-energiya" target="C.physics.vnutrennyaya-energiya"><data key="e_type">prerequisites_for</data><data key="e_why">потенциальная энергия взаимодействия частиц — слагаемое внутренней энергии</data></edge>
    <edge id="e623" source="C.physics.mehanicheskaya-rabota" target="C.physics.sovershenie-raboty"><data key="e_type">prerequisites_for</data><data key="e_why">работа над телом изменяет его энергию</data></edge>
    <edge id="e624" source="C.physics.vnutrennyaya-energiya" target="C.physics.sovershenie-raboty"><data key="e_type">prerequisites_for</data><data key="e_why">совершение работы — способ изменения внутренней энергии</data></edge>
    <edge id="e625" source="C.physics.vnutrennyaya-energiya" target="C.physics.teploperedacha"><data key="e_type">prerequisites_for</data><data key="e_why">теплопередача — изменение внутренней энергии без совершения работы</data></edge>
    <edge id="e626" source="C.physics.temperatura" target="C.physics.teploperedacha"><data key="e_type">prerequisites_for</data><data key="e_why">теплота переходит от более нагретого тела к менее нагретому</data></edge>
    <edge id="e627" source="C.physics.teploperedacha" target="C.physics.teplovye-yavleniya"><data key="e_type">is_a</data><data key="e_why">теплопередача — тепловое явление</data></edge>
    <edge id="e628" source="C.physics.izluchenie" target="C.physics.teploperedacha"><data key="e_type">is_a</data><data key="e_why">излучение — вид теплопередачи</data></edge>
    <edge id="e629" source="C.physics.konvektsiya" target="C.physics.teploperedacha"><data key="e_type">is_a</data><data key="e_why">конвекция — вид теплопередачи</data></edge>
    <edge id="e630" source="C.physics.teplovoe-rasshirenie" target="C.physics.konvektsiya"><data key="e_type">prerequisites_for</data><data key="e_why">нагретые слои расширяются, их плотность уменьшается</data></edge>
    <edge id="e631" source="C.physics.vytalkivayuschaya-sila" target="C.physics.konvektsiya"><data key="e_type">prerequisites_for</data><data key="e_why">нагретые слои поднимаются под действием архимедовой силы</data></edge>
    <edge id="e632" source="C.physics.teploprovodnost" target="C.physics.teploperedacha"><data key="e_type">is_a</data><data key="e_why">теплопроводность — вид теплопередачи</data></edge>
    <edge id="e633" source="C.physics.teplovoe-dvizhenie" target="C.physics.teploprovodnost"><data key="e_type">prerequisites_for</data><data key="e_why">энергия передаётся при взаимодействии хаотически движущихся частиц</data></edge>
    <edge id="e634" source="C.physics.teploperedacha" target="C.physics.kolichestvo-teploty"><data key="e_type">prerequisites_for</data><data key="e_why">количество теплоты — энергия, переданная при теплопередаче</data></edge>
    <edge id="e635" source="C.physics.kolichestvo-teploty" target="C.physics.udelnaya-teploemkost"><data key="e_type">prerequisites_for</data><data key="e_why">c = Q / (m·Δt)</data></edge>
    <edge id="e636" source="C.physics.massa" target="C.physics.udelnaya-teploemkost"><data key="e_type">prerequisites_for</data><data key="e_why">теплоёмкость отнесена к единице массы</data></edge>
    <edge id="e637" source="C.physics.teploobmen" target="C.physics.teplovoe-ravnovesie"><data key="e_type">prerequisites_for</data><data key="e_why">теплообмен идёт до установления теплового равновесия</data></edge>
    <edge id="e638" source="C.physics.temperatura" target="C.physics.teplovoe-ravnovesie"><data key="e_type">prerequisites_for</data><data key="e_why">в тепловом равновесии температуры тел равны</data></edge>
    <edge id="e639" source="C.physics.teploperedacha" target="C.physics.teploobmen"><data key="e_type">prerequisites_for</data><data key="e_why">теплообмен — теплопередача между телами системы</data></edge>
    <edge id="e640" source="C.physics.kolichestvo-teploty" target="C.physics.uravnenie-teplovogo-balansa"><data key="e_type">prerequisites_for</data><data key="e_why">уравнение связывает отданные и полученные количества теплоты</data></edge>
    <edge id="e641" source="C.physics.teplovoe-ravnovesie" target="C.physics.uravnenie-teplovogo-balansa"><data key="e_type">prerequisites_for</data><data key="e_why">уравнение записывается для установившегося равновесия</data></edge>
    <edge id="e642" source="C.physics.zakon-sohraneniya-i-prevrascheniya-energii" target="C.physics.uravnenie-teplovogo-balansa"><data key="e_order_issue">True</data><data key="e_type">prerequisites_for</data><data key="e_why">уравнение — следствие закона сохранения энергии, вводимого лишь в 6.16</data></edge>
    <edge id="e643" source="C.physics.plavlenie" target="C.physics.otverdevanie"><data key="e_type">prerequisites_for</data><data key="e_why">отвердевание — процесс, обратный плавлению</data></edge>
    <edge id="e644" source="C.physics.agregatnye-sostoyaniya-veschestva" target="C.physics.plavlenie"><data key="e_type">prerequisites_for</data><data key="e_why">плавление — переход из твёрдого состояния в жидкое</data></edge>
    <edge id="e645" source="C.physics.kristallicheskie-tela" target="C.physics.plavlenie"><data key="e_type">prerequisites_for</data><data key="e_why">изучается плавление кристаллических веществ</data></edge>
    <edge id="e646" source="C.physics.plavlenie" target="C.physics.udelnaya-teplota-plavleniya"><data key="e_type">prerequisites_for</data><data key="e_why">величина характеризует процесс плавления</data></edge>
