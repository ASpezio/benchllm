    <edge id="e668" source="C.physics.sovershenie-raboty" target="C.physics.teplovoy-dvigatel"><data key="e_type">prerequisites_for</data><data key="e_why">расширяющийся газ совершает работу за счёт внутренней энергии</data></edge>
