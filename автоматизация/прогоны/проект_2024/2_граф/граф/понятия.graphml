    <edge id="e448" source="C.physics.gaz" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">газ — одно из агрегатных состояний</data></edge>
    <edge id="e449" source="C.physics.zhidkost" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">жидкость — одно из агрегатных состояний</data></edge>
    <edge id="e450" source="C.physics.tverdoe-telo" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">твёрдое тело — одно из агрегатных состояний</data></edge>
    <edge id="e451" source="C.physics.agregatnye-sostoyaniya-vody" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">частный случай агрегатных состояний вещества</data></edge>
    <edge id="e452" source="C.physics.nablyudenie-teplovogo-rasshireniya-gazov" target="C.physics.teplovoe-rasshirenie"><data key="e_type">verifies</data><data key="e_why">опыт демонстрирует расширение газа при нагревании</data></edge>
    <edge id="e453" source="C.physics.obnaruzhenie-deystviya-sil-molekulyarnogo-prityazheniya" target="C.physics.prityazhenie-chastits-veschestva"><data key="e_type">verifies</data><data key="e_why">опыт обнаруживает притяжение молекул</data></edge>
    <edge id="e454" source="C.physics.otsenka-diametra-atoma-metodom-ryadov" target="C.physics.razmery-atomov-i-molekul"><data key="e_type">verifies</data><data key="e_why">в работе оценивается размер атома</data></edge>
