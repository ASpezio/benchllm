    <edge id="e445" source="C.physics.prityazhenie-chastits-veschestva" target="C.physics.vzaimodeystvie-chastits-veschestva"><data key="e_type">is_a</data><data key="e_why">притяжение — вид взаимодействия частиц</data></edge>
