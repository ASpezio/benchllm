    <edge id="e680" source="C.physics.nablyudenie-izmeneniya-vnutrenney-energii-tela-v-rezultate-teploperedachi-i-rabo" target="C.physics.teploperedacha"><data key="e_type">verifies</data><data key="e_why">энергия меняется при теплопередаче</data></edge>
    <edge id="e681" source="C.physics.nablyudenie-izmeneniya-vnutrenney-energii-tela-v-rezultate-teploperedachi-i-rabo" target="C.physics.sovershenie-raboty"><data key="e_type">verifies</data><data key="e_why">энергия меняется при совершении работы</data></edge>
