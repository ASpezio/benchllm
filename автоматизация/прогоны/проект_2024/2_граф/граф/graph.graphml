    <edge id="e6933" source="C.physics.issledovanie-nezavisimosti-vytalkivayuschey-sily-ot-massy-tela" target="C.physics.zakon-arhimeda"><data key="e_type">verifies</data><data key="e_why">проверяется, что сила не зависит от массы тела</data></edge>
    <edge id="e6934" source="C.physics.konstruirovanie-areometra" target="C.physics.plavanie-tel"><data key="e_type">verifies</data><data key="e_why">ареометр плавает, погружаясь по-разному в разные жидкости</data></edge>
