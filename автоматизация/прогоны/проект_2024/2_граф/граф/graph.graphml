    <edge id="e6398" source="C.history.istoricheskiy-istochnik" target="C.history.spetsialnye-istoricheskie-distsipliny"><data key="e_type">prerequisites_for</data><data key="e_why">вспомогательные дисциплины изучают отдельные виды источников</data></edge>
    <edge id="e6399" source="C.history.schet-let-do-n-e-i-n-e" target="C.history.istoricheskaya-hronologiya"><data key="e_type">part_of</data><data key="e_why">счёт лет до н. э. и н. э. — основа исторической хронологии</data></edge>
    <edge id="e6400" source="C.history.chelovek-razumnyy" target="C.history.verovaniya-pervobytnyh-lyudey"><data key="e_type">prerequisites_for</data><data key="e_why">верования появились у людей современного типа</data></edge>
    <edge id="e6401" source="C.history.zemledelie" target="C.history.proizvodyaschee-hozyaystvo"><data key="e_type">is_a</data><data key="e_why">земледелие — форма производящего хозяйства</data></edge>
    <edge id="e6402" source="C.history.razlozhenie-pervobytnoobschinnyh-otnosheniy" target="C.history.znat"><data key="e_type">prerequisites_for</data><data key="e_why">знать выделилась при разложении первобытной общины</data></edge>
    <edge id="e6403" source="C.history.chelovek-razumnyy" target="C.history.iskusstvo-pervobytnyh-lyudey"><data key="e_type">prerequisites_for</data><data key="e_why">наскальное искусство создано человеком разумным</data></edge>
    <edge id="e6404" source="C.history.remeslo" target="C.history.obmen"><data key="e_type">prerequisites_for</data><data key="e_why">обменивались изделиями ремесленников и продуктами земледельцев</data></edge>
    <edge id="e6405" source="C.history.ovladenie-ognem" target="C.history.evolyutsiya-drevneyshego-cheloveka"><data key="e_type">part_of</data><data key="e_why">овладение огнём — важный шаг в развитии древнейших людей</data></edge>
    <edge id="e6406" source="C.history.ohota" target="C.history.zanyatiya-pervobytnyh-lyudey"><data key="e_type">part_of</data><data key="e_why">охота — одно из главных занятий первобытных людей</data></edge>
    <edge id="e6407" source="C.history.ohota" target="C.history.prisvaivayuschee-hozyaystvo"><data key="e_type">is_a</data><data key="e_why">охота — форма присваивающего хозяйства</data></edge>
    <edge id="e6408" source="C.history.prisvaivayuschee-hozyaystvo" target="C.history.proizvodyaschee-hozyaystvo"><data key="e_type">prerequisites_for</data><data key="e_why">производящее хозяйство пришло на смену присваивающему</data></edge>
    <edge id="e6409" source="C.history.rodovaya-obschina" target="C.history.razlozhenie-pervobytnoobschinnyh-otnosheniy"><data key="e_type">prerequisites_for</data><data key="e_why">разлагалась именно родовая община</data></edge>
    <edge id="e6410" source="C.history.proizvodyaschee-hozyaystvo" target="C.history.razlozhenie-pervobytnoobschinnyh-otnosheniy"><data key="e_type">prerequisites_for</data><data key="e_why">излишки производящего хозяйства породили неравенство</data></edge>
    <edge id="e6411" source="C.history.proishozhdenie-cheloveka" target="C.history.rasselenie-drevneyshego-cheloveka"><data key="e_type">prerequisites_for</data><data key="e_why">расселялись появившиеся в Африке древнейшие люди</data></edge>
    <edge id="e6412" source="C.history.ovladenie-ognem" target="C.history.rasselenie-drevneyshego-cheloveka"><data key="e_type">prerequisites_for</data><data key="e_why">огонь позволил людям жить в холодных районах</data></edge>
    <edge id="e6413" source="C.history.proizvodyaschee-hozyaystvo" target="C.history.remeslo"><data key="e_type">prerequisites_for</data><data key="e_why">выделение ремесла возможно при производящем хозяйстве</data></edge>
    <edge id="e6414" source="C.history.rod" target="C.history.rodovaya-obschina"><data key="e_type">prerequisites_for</data><data key="e_why">родовая община объединяет родственников одного рода</data></edge>
    <edge id="e6415" source="C.history.skotovodstvo" target="C.history.proizvodyaschee-hozyaystvo"><data key="e_type">is_a</data><data key="e_why">скотоводство — форма производящего хозяйства</data></edge>
    <edge id="e6416" source="C.history.sobiratelstvo" target="C.history.zanyatiya-pervobytnyh-lyudey"><data key="e_type">part_of</data><data key="e_why">собирательство — одно из главных занятий первобытных людей</data></edge>
    <edge id="e6417" source="C.history.sobiratelstvo" target="C.history.prisvaivayuschee-hozyaystvo"><data key="e_type">is_a</data><data key="e_why">собирательство — форма присваивающего хозяйства</data></edge>
    <edge id="e6418" source="C.history.rodovaya-obschina" target="C.history.sosedskaya-obschina"><data key="e_type">prerequisites_for</data><data key="e_why">соседская община сменила родовую: связь по соседству, а не родству</data></edge>
    <edge id="e6419" source="C.history.obmen" target="C.history.torgovlya"><data key="e_type">prerequisites_for</data><data key="e_why">торговля выросла из регулярного обмена</data></edge>
