    <edge id="e6936" source="C.physics.konstruirovanie-lodki-i-opredelenie-ee-gruzopodemnosti" target="C.physics.plavanie-tel"><data key="e_type">verifies</data><data key="e_why">грузоподъёмность определяется условием плавания</data></edge>
    <edge id="e6937" source="C.physics.opredelenie-vytalkivayuschey-sily" target="C.physics.vytalkivayuschaya-sila"><data key="e_type">verifies</data><data key="e_why">в работе измеряется выталкивающая сила</data></edge>
